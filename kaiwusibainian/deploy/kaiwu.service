[Unit]
Description=Kaiwu Si Bai Nian web service (FastAPI + SQLite)
After=network.target

[Service]
WorkingDirectory=/opt/kaiwu/backend
# 把 sk-xxx 换成你自己的 DeepSeek 密钥；留空则 AI 问答自动降级为本地知识库
Environment=DEEPSEEK_API_KEY=
ExecStart=/opt/kaiwu/venv/bin/python -m uvicorn main:app --host 0.0.0.0 --port 8100
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
